{
  "name": "doomsday-surfers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "check:gen": "bun scripts/check-generator.ts",
    "ios:sync": "bun run build && bunx cap sync ios",
    "ios:open": "bunx cap open ios",
    "ios:run": "bun run build && bunx cap run ios",
    "ios:testflight": "sh scripts/testflight.sh",
    "assets": "sh scripts/assets.sh"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  }
}
